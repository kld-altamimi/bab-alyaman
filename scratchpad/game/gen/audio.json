oud."},"bilqis_round":{"at":[92.2458,1.1076],"who":"BILQIS","text":"One round. One problem."},"arwa_still":{"at":[93.4534,1.6356],"who":"ARWA","text":"Hold still. This stings."},"arwa_umbrella":{"at":[95.1889,1.3343],"who":"ARWA","text":"I brought an umbrella. Obviously."},"grunt_scream":{"at":[96.6232,0.8],"who":"RIFLEMAN","text":""},"grunt_yelp":{"at":[97.5232,0.22],"who":"RIFLEMAN","text":""},"cook_wail":{"at":[97.8432,0.6],"who":"COOK","text":""},"guard_hmph":{"at":[98.5432,0.5],"who":"THE GUARD","text":""},"uncle_drones":{"at":[99.1432,4.4232],"who":"THE UNCLE","text":"The flying boat is a loan. Do not scratch it."},"uncle_guns":{"at":[103.6665,4.515],"who":"THE UNCLE","text":"Use the new guns. Do not ask where from."},"uncle_coffee":{"at":[108.2815,3.9896],"who":"THE UNCLE","text":"I want the coffee. All of it. For the cause."},"uncle_cheque":{"at":[112.3711,4.2376],"who":"THE UNCLE","text":"The cheque is in the post. Which post? A post."},"ann_souq":{"at":[116.7087,2.6543],"who":"ANNOUNCER","text":"AND WE'RE OFF! THE SOUQ!"},"yazeed_souq":{"at":[119.463,2.6393],"who":"YAZEED","text":"Mind the spice. Especially the red."},"yazeed_chilli":{"at":[122.2023,2.6739],"who":"YAZEED","text":"Chilli. In the eyes. Lovely."},"yazeed_lunch":{"at":[124.9762,3.1517],"who":"YAZEED","text":"Good. Now, lunch. Not too spicy."},"grunt_eyes":{"at":[128.2279,1.3079],"who":"RIFLEMAN","text":"My eyes! MY EYES!"},"grunt_wall":{"at":[129.6358,1.928],"who":"RIFLEMAN","text":"That took us all morning!"},"shop_tea":{"at":[131.6638,3.9165],"who":"SHOPKEEPER","text":"Thank you, thank you. Come back for tea. Any time."},"shop_thanks":{"at":[135.6803,3.1365],"who":"SHOPKEEPER","text":"Thank you, son. Take this. Go carefully."},"shop_cloth":{"at":[138.9168,3.0169],"who":"SHOPKEEPER","text":"My shop... Thank you. Take these, you'll need them."},"uncle_spice":{"at":[142.0337,6.4615],"who":"THE UNCLE","text":"The spice is mine. Hide it where nobody looks."},"yazeed_sneeze":{"at":[148.5952,1.42],"who":"YAZEED","text":""},"grunt_sneeze":{"at":[150.1152,0.78],"who":"RIFLEMAN","text":""},"tl_welcome":{"at":[150.9952,3.5766],"who":"TAILOR","text":"Welcome! Everything here is made to measure. Including you."},"yazeed_coat":{"at":[154.6718,3.0036],"who":"YAZEED","text":"They're all wearing the same coat."},"tl_dummy":{"at":[157.7754,2.6269],"who":"TAILOR","text":"I'm a dummy! Dummies don't talk!"},"tl_silk":{"at":[160.5023,1.6459],"who":"TAILOR","text":"Not the silk!"},"tl_more":{"at":[162.2482,2.2989],"who":"TAILOR","text":"More dummies! I have plenty."},"tl_cover":{"at":[164.6471,2.1464],"who":"TAILOR","text":"Cover them! Cover everything!"},"tl_surrender":{"at":[166.8935,3.1873],"who":"TAILOR","text":"All right! The coat is on the house."},"tl_ow":{"at":[170.1808,0.22],"who":"TAILOR","text":""},"tl_whoa":{"at":[170.5008,0.9395],"who":"TAILOR","text":""},"grunt_qanya":{"at":[171.5404,0.9444],"who":"RIFLEMAN","text":"THE BLACK JINN!"},"ann_taiz":{"at":[172.5847,2.6231],"who":"ANNOUNCER","text":"AND WE'RE OFF! THE CASTLE!"},"grunt_count":{"at":[175.3078,2.4943],"who":"RIFLEMAN","text":"Ten! Nine! Eight! ...Eight?"},"cmdr_again":{"at":[177.9021,3.2224],"who":"COMMANDER","text":"From the top, you donkey!"}},"music":{"strait":{"file":"music_strait","seconds":51.2},"battery":{"file":"music_battery","seconds":24.006531},"start":{"file":"jingle_start","seconds":4.5216,"landing":3.2},"complete":{"file":"jingle_complete","seconds":5.5644},"title":{"file":"music_title","seconds":45.714286},"map":{"file":"music_map","seconds":51.435102},"mocha":{"file":"music_mocha","seconds":58.174694},"roaster":{"file":"music_roaster","seconds":22.857143},"souq":{"file":"music_souq","seconds":55.640816},"tailor":{"file":"music_tailor","seconds":36.91102},"taiz":{"file":"music_taiz","seconds":53.342041},"taizboss":{"file":"music_taizboss","seconds":24.006531}},"speech":{"ibb":{"file":"speech_ibb","lines":{"sp_important":{"who":"BRIGADIER BREAKING","text":"An important statement.","m":"02222210022222210000000","at":[0.2012,1.5202]},"sp_A2":{"who":"BRIGADIER BREAKING","text":"Zanabeel forces carried out a special operation in Taiz.","m":"0221222222212122212212122222212222201212222110000000","at":[1.8215,3.4565]},"sp_A3":{"who":"BRIGADIER BREAKING","text":"With a roaster, a cannon from the castle, and a flying boat.","m":"022202220121212111222222022012222111222222200000000","at":[5.378,3.3354]},"sp_A4":{"who":"BRIGADIER BREAKING","text":"Correction: the flying boat was not in Taiz.","m":"02222210222222221222212122211222222100000000","at":[8.8134,2.9028]},"sp_A5":{"who":"BRIGADIER BREAKING","text":"The operation achieved its objectives successfully.","m":"12121221222112222222202212222001222222100000000","at":[11.8162,3.0738]},"sp_A6":{"who":"BRIGADIER BREAKING","text":"Correction: most of its objectives.","m":"02222210022212212222222220000000","at":[14.99,2.1277]},"sp_A7":{"who":"BRIGADIER BREAKING","text":"Taiz remains in our hands.","m":"0222212212221222122222220000000","at":[17.2177,2.0283]},"sp_A8":{"who":"BRIGADIER BREAKING","text":"Most of it.","m":"02121212222220000000","at":[19.3461,1.2961]},"sp_ops":{"who":"BRIGADIER BREAKING","text":"Operations continue until the Uncle is satisfied.","m":"12222122211122222222212210021122212221222210000000","at":[20.7422,3.3168]},"sp_end":{"who":"BRIGADIER BREAKING","text":"End of statement.","m":"1112121222222000000000","at":[24.159,1.4014]},"sp_A11":{"who":"BRIGADIER BREAKING","text":"Are we still on air?","m":"12212122222121222220000000","at":[25.6603,1.7219]},"sp_B2":{"who":"BRIGADIER BREAKING","text":"We struck the enemy with twenty missiles.","m":"11122121202222212221122122222122220000000","at":[27.4822,2.7163]},"sp_B3":{"who":"BRIGADIER BREAKING","text":"Eighteen of them blew up before launch.","m":"022122111221222221200121222222222210000000","at":[30.2985,2.742]},"sp_B4":{"who":"BRIGADIER BREAKING","text":"And two on the way.","m":"12120221210121222122222222210000000","at":[33.1405,2.277]},"sp_B5":{"who":"BRIGADIER BREAKING","text":"One enemy sandal has been captured.","m":"12120221211122222212222221222221222222222210000000","at":[35.5175,3.2755]},"sp_B6":{"who":"BRIGADIER BREAKING","text":"Our objectives have thus been achieved successfully.","m":"1212221222122202212202212122001222222110000000","at":[38.893,3.008]},"sp_C2":{"who":"BRIGADIER BREAKING","text":"We call upon the so-called Yazeed to observe the truce and show restraint.","m":"022222222222222200122120221222202221222220000000","at":[42.001,3.1803]},"sp_C3":{"who":"BRIGADIER BREAKING","text":"Any further advance on Ibb will be met with a response.","m":"1222022211222122211220110012112221111222200000000","at":[45.2814,3.227]},"sp_C4":{"who":"BRIGADIER BREAKING","text":"A harsh response.","m":"2212212212222220000000","at":[48.6084,1.4393]},"sp_C5":{"who":"BRIGADIER BREAKING","text":"Possibly harsher.","m":"1221122221222220000000","at":[50.1477,1.4282]},"sp_C6":{"who":"BRIGADIER BREAKING","text":"You have been warned.","m":"1212122121122100000000","at":[51.6759,1.4021]},"sp_C7":{"who":"BRIGADIER BREAKING","text":"You, your driver, and the car.","m":"22121022222222101212222222220000000","at":[53.178,2.3241]},"sp_D2":{"who":"BRIGADIER BREAKING","text":"We announce the launch of Operation Steadfast Victorious Mighty Wind.","m":"01221110122212112211210211121221212101212121111201122210000000","at":[55.6021,4.0914]},"sp_D3":{"who":"BRIGADIER BREAKING","text":"Balance of Steadfastness 47.","m":"0222211211212200022222212221100000000","at":[59.7935,2.4375]},"sp_D4":{"who":"BRIGADIER BREAKING","text":"Part Two, Phase One.","m":"2212222122122012122222222222210000000","at":[62.331,2.4093]},"sp_D5":{"who":"BRIGADIER BREAKING","text":"The operation has begun.","m":"1212022221122222222210000000","at":[64.8403,1.8121]},"sp_D6":{"who":"BRIGADIER BREAKING","text":"And ended.","m":"12022222210000000","at":[66.7524,1.1025]},"sp_D7":{"who":"BRIGADIER BREAKING","text":"Its results will be announced in a later statement.","m":"12121222222222222222222221222222110000000","at":[67.9549,2.6715]},"sp_D9":{"who":"BRIGADIER BREAKING","text":"The time is four o'clock.","m":"211222222212222210000000","at":[70.7264,1.5484]},"sp_E2":{"who":"BRIGADIER BREAKING","text":"Zanabeel forces confirm that the Uncle is satisfied.","m":"02221212222021222222212212212222210000000","at":[72.3748,2.7298]},"sp_E3":{"who":"BRIGADIER BREAKING","text":"Very satisfied.","m":"12221110222220000000","at":[75.2046,1.2839]},"sp_E4":{"who":"BRIGADIER BREAKING","text":"And that the roaster was not part of the deal.","m":"122022221222212121110101111121222110000000","at":[76.5885,2.7354]},"sp_E5":{"who":"BRIGADIER BREAKING","text":"Nor the boat.","m":"122212212210000000","at":[79.4238,1.1711]},"sp_E6":{"who":"BRIGADIER BREAKING","text":"Nor scratching it.","m":"122212112122200000000","at":[80.695,1.3368]},"sp_E7":{"who":"BRIGADIER BREAKING","text":"We confirm we did not scratch it.","m":"122221212122222222111122220000000","at":[82.1318,2.1811]},"sp_E9":{"who":"BRIGADIER BREAKING","text":"More.","m":"22122210000000","at":[84.4129,0.9111]}},"statements":{"A":["sp_important","sp_A2","sp_A3","sp_A4","sp_A5","sp_A6","sp_A7","sp_A8","sp_ops","sp_end","sp_A11"],"B":["sp_important","sp_B2","sp_B3","sp_B4","sp_B5","sp_B6","sp_end"],"C":["sp_important","sp_C2","sp_C3","sp_C4","sp_C5","sp_C6","sp_C7","sp_end"],"D":["sp_important","sp_D2","sp_D3","sp_D4","sp_D5","sp_D6","sp_D7","sp_important","sp_D9","sp_end"],"E":["sp_important","sp_E2","sp_E3","sp_E4","sp_E5","sp_E6","sp_E7","sp_ops","sp_E9","sp_end"]}}}}